# Production URLs; use HTTPS and verified domains.
NEXT_PUBLIC_SITE_URL=https://globesecure.ca
# Server-side transactional email. The contact endpoint fails closed when absent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Deployment is disabled by default; see docs/DEPLOYMENT.md.

# Required to activate authenticated portals (contract in docs/AUTH.md).
TAKATAK_OIDC_ISSUER=
TAKATAK_OIDC_CLIENT_ID=
TAKATAK_OIDC_CLIENT_SECRET=
SESSION_SECRET=
# PostgreSQL 13+, migration db/migrations/001_init.sql
DATABASE_URL=

# Requires approved complete privacy notice and retention policy before intake.
PRIVACY_POLICY_APPROVED=false
CAREERS_TO_EMAIL=
